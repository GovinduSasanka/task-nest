{
  "name": "task-nest",
  "productName": "Task Nest",
  "version": "1.0.0",
  "description": "A cute, Notion-style task widget that lives on your desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "icon": "electron build/make-icon.js"
  },
  "author": "Task Nest",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.tasknest.widget",
    "productName": "Task Nest",
    "copyright": "Task Nest",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Task Nest",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Task-Nest-Setup-${version}.${ext}"
    }
  }
}